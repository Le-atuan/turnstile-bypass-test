# Path to Chrome, only if auto-detection fails (e.g. a non-standard install).
# macOS default: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=

# Target page with the Turnstile widget
TARGET_SITEURL=https://tracuu.einvoice365.com/

# Turnstile sitekey (from window.TURNSTILE_SITE_KEY)
TARGET_SITEKEY=0x4AAAAAACA6lZiDGKBtjbxg

# Backend lookup endpoint. Candidates from portal.js: /ptop/psearch,
# /ptopnew/psearch, /ptopnew/pcussearch, /api/inv/minutes/param.
# Confirm the real one via DevTools Network tab before trusting results.
VERIFY_ENDPOINT=https://tracuu.einvoice365.com/ptop/psearch

# Method the endpoint expects: POST or GET
VERIFY_METHOD=POST

# Form field name for the token (Cloudflare default)
VERIFY_TOKEN_FIELD=cf-turnstile-response

# Extra fields beyond tax_code/lookup_code, as JSON (those two are sent automatically)
VERIFY_EXTRA_FIELDS={}

# Real tax_code + lookup_code pairs to test, one run each. Used by both scripts.
TEST_CASES=[{"tax_code":"0314218920","lookup_code":"j5nnm3lzo5"},{"tax_code":"0400495597","lookup_code":"mr3pye3m65"},{"tax_code":"0301867702","lookup_code":"8gdknm311r"},{"tax_code":"0314218920","lookup_code":"zgx9kzy1zg"}]

# Max seconds to wait for the Turnstile token
TOKEN_WAIT_TIMEOUT=20

# Max seconds to wait for the result banner after clicking "Tra cứu"
RESULT_WAIT_TIMEOUT=20

# Retries per test case on a technical failure (not on "not found")
MAX_ATTEMPTS=3

# Phrases meaning "no record found" (guessed — adjust after a real response)
NOT_FOUND_KEYWORDS=không tìm thấy,không có dữ liệu,không tồn tại,not found,no data,no record
