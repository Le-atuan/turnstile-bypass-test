# Target page + Turnstile sitekey
TARGET_SITEURL=https://tracuu.einvoice365.com/
TARGET_SITEKEY=0x4AAAAAACA6lZiDGKBtjbxg

# Backend lookup endpoint (found via capture_request.py)
VERIFY_ENDPOINT=https://tracuu.einvoice365.com/api/search
VERIFY_METHOD=POST
VERIFY_TOKEN_FIELD=token
VERIFY_EXTRA_FIELDS={}

# result_json-shaped test cases; used by capture_request.py (first pair only)
# and as run_test.py's fallback when test_cases.json doesn't exist.
TEST_CASES=[{"info":{"tax_code":"0314218920","lookup_code":"j5nnm3lzo5"}},{"info":{"tax_code":"0400495597","lookup_code":"mr3pye3m65"}},{"info":{"tax_code":"0301867702","lookup_code":"8gdknm311r"}},{"info":{"tax_code":"0314218920","lookup_code":"zgx9kzy1zg"}}]

# Turnstile solver backend: uc or nodriver (nodriver is blocked on this site)
SOLVER_BACKEND=uc

# run_test.py: concurrent browsers (1 = sequential)
MAX_WORKERS=1

# Retries per case on technical error only
MAX_ATTEMPTS=3

# Phrases meaning a genuine "no record found" (only trusted on a 2xx JSON)
NOT_FOUND_KEYWORDS=không tìm thấy,không có dữ liệu,không tồn tại,not found,no data,no record

# HTTP statuses classified as rate-limited
RATE_LIMIT_STATUSES=429

# Body/markers classified as a bot challenge / WAF block
CHALLENGE_MARKERS=just a moment,attention required,challenge-platform,__cf_chl,cf-chl,captcha,access denied,request blocked,error 1020,error 1015

# Only needed if Chrome isn't auto-detected. Leave blank otherwise.
# Linux:   /usr/bin/google-chrome-stable
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
