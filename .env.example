# The exact page on YOUR site that renders the Turnstile widget.
TARGET_SITEURL=https://tracuu.einvoice365.com/

# Confirmed from live DOM observation (window.TURNSTILE_SITE_KEY):
TARGET_SITEKEY=0x4AAAAAACA6lZiDGKBtjbxg

# Confirmed widget mode: managed/invisible — no checkbox/puzzle shown to
# users, resolves in the background in ~1-2s. The "Tra cứu" button stays
# disabled (gray) until window-level JS sets the hidden input
# #cf-chl-widget-xxxxx_response (name="cf-turnstile-response"). This means
# any solver that can (a) load the page and (b) wait for the Turnstile
# callback should get a token without needing to click anything.

# Candidate internal endpoints seen in portal.js (unconfirmed params/shape):
#   /ptop/psearch
#   /ptopnew/psearch
#   /ptopnew/pcussearch
#   /api/inv/minutes/param
# Pick the one that matches the "Tra cứu" button's actual call (inspect via
# DevTools Network tab with "Preserve log" BEFORE loading the page) and set
# it below. Do not guess the request shape — confirm it from your own
# frontend code or a captured request on a TEST lookup.
VERIFY_ENDPOINT=https://tracuu.einvoice365.com/ptop/psearch

# HTTP method your backend expects for that endpoint: POST or GET
VERIFY_METHOD=POST

# The form field name your backend expects the token under.
# Cloudflare's JS widget submits it as "cf-turnstile-response" by default,
# confirmed as the hidden input's `name` attribute on this page.
VERIFY_TOKEN_FIELD=cf-turnstile-response

# Any EXTRA form fields your endpoint requires beyond tax_code/lookup_code
# (run_test.py already sends those two field names directly from each
# TEST_CASES entry below — don't duplicate them here). JSON object, merged
# into the request alongside the token.
VERIFY_EXTRA_FIELDS={}

# --- Shared by both run_test.py (raw HTTP POST) and run_ui_test.py -----
# (real form fill) -------------------------------------------------------
# Real tax_code + lookup_code pairs, explicitly authorized by the site
# owner for this defensive test. Each pair can only be used to LOOK UP
# one specific already-issued invoice — it grants no further access. Do
# not add pairs you haven't been explicitly told are safe to commit. One
# run per pair, in order, in BOTH scripts.
TEST_CASES=[{"tax_code":"0314218920","lookup_code":"j5nnm3lzo5"},{"tax_code":"0400495597","lookup_code":"mr3pye3m65"},{"tax_code":"0301867702","lookup_code":"8gdknm311r"},{"tax_code":"0314218920","lookup_code":"zgx9kzy1zg"}]

# Max seconds to wait for the page's own Turnstile widget to resolve
# before giving up (managed/invisible mode normally takes ~1-2s).
TOKEN_WAIT_TIMEOUT=20

# If a run fails at a TECHNICAL step (browser launch, navigation, token
# wait, form fill, submit, reading the result), retry it this many times
# total before giving up on that test case. Each attempt opens a fresh
# browser. A page response that just says "not found" is NOT a technical
# failure and is never retried — see NOT_FOUND_KEYWORDS below.
MAX_ATTEMPTS=3

# Comma-separated phrases that mean "the site answered normally — no
# record for this pair," so the run stops there (no retry) and reports
# that result as-is, instead of treating it like a bug.
# GUESS, NOT CONFIRMED against the real page — no test run has hit a real
# "not found" response yet. After your first run that does, check the
# logged page content / saved HTML and adjust this list if the real
# wording differs.
NOT_FOUND_KEYWORDS=không tìm thấy,không có dữ liệu,không tồn tại,not found,no data,no record
